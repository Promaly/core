NODE_ENV=development
PROMALY_IMAGE=promaly
# Set to a published release, e.g. v0.1.0 — never latest.
PROMALY_VERSION=v0.1.0
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://promaly:promaly@localhost:5432/promaly
MIGRATION_DATABASE_URL=postgres://promaly:promaly@localhost:5432/promaly
S3_ENDPOINT=http://localhost:9000
PROMALY_S3_BUCKET=promaly
S3_REGION=us-east-1
METRICS_HOST=127.0.0.1
METRICS_PORT=9090
# Leave unset unless the metrics endpoint needs a bearer-token guard.
METRICS_TOKEN=
OTEL_TRACES_ENABLED=false
OTEL_SERVICE_NAME=promaly-api
# Set only when OTEL_TRACES_ENABLED=true.
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_APP_PASSWORD=change-me-before-deploying
MINIO_ROOT_USER=promaly
MINIO_ROOT_PASSWORD=change-me-before-deploying

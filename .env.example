# Promaly Core — optional deployment overrides.
#
# You do NOT need this file. `docker compose up -d` works with no .env: internal
# database and object-storage credentials are generated automatically, and the
# first admin account is created in the web UI on first visit.
#
# Copy to `.env` only to change one of the settings below.

# --- Public port -----------------------------------------------------------
# Host port the API is published on (put your TLS proxy in front of it).
# PROMALY_PORT=3000

# --- Email (optional) ----------------------------------------------------
# In-app notifications work without this; set it to also send email.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# SMTP_FROM=promaly@example.com

# --- Operations -------------------------------------------------------
# LOG_LEVEL=info                 # fatal | error | warn | info | debug | trace
# METRICS_TOKEN=                 # bearer token if a sidecar scrapes /metrics
# OTEL_TRACES_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --- External object storage (skip the bundled MinIO) --------------------
# S3_REGION=us-east-1
# PROMALY_S3_BUCKET=promaly

# --- Run a published image instead of building from this checkout --------
# PROMALY_IMAGE=ghcr.io/promaly/promaly
# PROMALY_VERSION=v0.2.0
# PROMALY_PULL_POLICY=always

{
  "name": "@promaly/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "test:integration": "RUN_DATABASE_TESTS=true vitest run src/drain.integration.test.ts"
  },
  "dependencies": {
    "@promaly/config": "workspace:*",
    "@promaly/db": "workspace:*",
    "@promaly/domain": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "vitest": "^3.2.4",
    "@testcontainers/postgresql": "^12.1.0",
    "testcontainers": "^12.1.0",
    "uuidv7": "^1.2.1"
  }
}
